[gd_scene format=3]
[node name="OrderScreen" type="Control"]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 0

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.98, 0.94, 0.87, 1)

[node name="Content" type="MarginContainer" parent="."]
layout_mode = 0
theme_override_constants/margin_left = 32
theme_override_constants/margin_right = 32
theme_override_constants/margin_top = 32
theme_override_constants/margin_bottom = 32

[node name="Layout" type="VBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Heading" type="Label" parent="Content/Layout"]
layout_mode = 2
text = "Guest order"
horizontal_alignment = 1

[node name="Patience" type="Label" parent="Content/Layout"]
layout_mode = 2
text = "Patience: 60s"
horizontal_alignment = 1

[node name="SpaceAbove" type="Control" parent="Content/Layout"]
layout_mode = 2
size_flags_vertical = 3

[node name="Description" type="Label" parent="Content/Layout"]
layout_mode = 2
text = "Basic Coffee"
autowrap_mode = 2
horizontal_alignment = 1

[node name="Progress" type="ProgressBar" parent="Content/Layout"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
max_value = 1.0
show_percentage = false

[node name="Action" type="Button" parent="Content/Layout"]
layout_mode = 2
theme_type_variation = &"PrimaryButton"
text = "Accept Order"

[node name="SpaceBelow" type="Control" parent="Content/Layout"]
layout_mode = 2
size_flags_vertical = 3

[node name="Settings" type="Button" parent="Content/Layout"]
layout_mode = 2
text = "Settings"

[node name="Back" type="Button" parent="Content/Layout"]
layout_mode = 2
text = "Back to café"
